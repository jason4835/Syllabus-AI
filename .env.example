# ---------------------------------------------------------------------------
# Syllabus AI
#
# LOCAL DEV: every value below is optional. With none of them set the app boots
# in demo mode -- sample syllabi, heuristic parsing, local JSON storage, and a
# dry-run calendar sync.
#
# PRODUCTION: SESSION_SECRET and the two SUPABASE_* values are REQUIRED.
# See docs/DEPLOY.md. GET /api/health reports "degraded" when they are missing.
# ---------------------------------------------------------------------------

# AI extraction. Without it, uploads fall back to the heuristic parser.
OPENAI_API_KEY=

# Google sign-in + Calendar write access.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application), enable the Google Calendar API, and add the redirect
# URI below to the client's authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Signs the session cookie. REQUIRED IN PRODUCTION -- the app refuses to serve
# requests without it (>= 32 chars), because the dev fallback is a published
# constant and anyone knowing it can forge a session for any account.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Persistence. Without both, data goes to .data/db.json on local disk -- which
# is fine locally and NOT usable on serverless, where the filesystem is
# ephemeral and per-invocation. Supabase is mandatory for a real deployment.
# Run supabase/schema.sql against the project first.
# The service-role key bypasses RLS: server-only, never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
