# ---------------------------------------------------------------------------
# Syllabus AI
#
# LOCAL DEV: every value below is optional. With none of them set the app boots
# in demo mode -- sample syllabi, heuristic parsing, local JSON storage, and a
# dry-run calendar sync.
#
# PRODUCTION: SESSION_SECRET is REQUIRED, plus durable storage -- either the
# two SUPABASE_* values or a mounted volume via DATA_DIR.
# See docs/DEPLOY.md. GET /api/health reports "degraded" when they are missing.
# ---------------------------------------------------------------------------

# AI extraction. Without it, uploads fall back to the heuristic parser.
OPENAI_API_KEY=

# Models, both optional. Leave them unset unless you have a reason.
#
# Two variables rather than one because the two calls have opposite economics:
# parsing is rare, long and worth a strong model, while chat is frequent, short
# and answered well by a small one. A single shared OPENAI_MODEL meant upgrading
# the parser silently upgraded chat too, at many times the cost per token, with
# nothing locally to show it. OPENAI_MODEL is still read as a fallback for both,
# so an existing deployment keeps working.
OPENAI_PARSE_MODEL=
# The organization's tokens-per-minute limit for the parse model. Uploads are
# paced to it (waiting up to a minute for budget) so a burst of uploads is read
# by the model rather than tripping a 429 and falling to pattern matching. A
# new OpenAI organization gets 30,000 TPM on gpt-4o; higher usage tiers get
# more -- check Settings > Limits and raise this to match.
OPENAI_TPM=30000
OPENAI_CHAT_MODEL=

# Google sign-in + Calendar write access.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application), enable the Google Calendar API, and add the redirect
# URI below to the client's authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Notion: one finished page per class plus Assignments and Study Sessions
# databases. Create a PUBLIC integration at https://www.notion.so/my-integrations
# (OAuth) and add the redirect URI below to it. Optional: without these the
# Notion panel says it is not configured and sync reports a dry run.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/api/notion/callback

# --- Stripe (Academic Term Pass) ---
#
# One-time $5.99 payment that unlocks premium access for one academic term.
# Product rules: docs/TERM-PASS.md. Setup walkthrough: docs/DEPLOY.md section 9.
# All four of these are server-only -- none may ever carry a NEXT_PUBLIC_ prefix.
#
# Secret key. Dashboard -> Developers -> API keys -> Secret key
# (sk_test_... in test mode, sk_live_... once you go live).
STRIPE_SECRET_KEY=
# Publishable key, same Dashboard page. Not used by the server today -- kept
# here for a future client-side Stripe element, if one gets added.
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret. Dashboard -> Developers -> Webhooks -> your endpoint
# -> Signing secret (whsec_...). For local dev, `stripe listen` prints its own
# whsec_ value -- use that one, not the Dashboard's. See docs/DEPLOY.md.
STRIPE_WEBHOOK_SECRET=
# The id of the one-time $5.99 "Academic Term Pass" price (price_...).
# Dashboard -> Product catalog -> Academic Term Pass -> the price -> copy ID.
# This is the only place the price id lives; the $5.99 amount itself is never
# hardcoded -- src/lib/pricing.ts reads it back for display.
STRIPE_TERM_PASS_PRICE_ID=
#
# Without STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET and STRIPE_TERM_PASS_PRICE_ID
# all set, billing is off: uploads and everything else keep working, and the
# Term Pass paywall shows "not configured" copy instead of a Buy button.

# The public origin users actually reach, with no trailing slash, e.g.
# https://www.syllabuscenter.com -- SET THIS IN PRODUCTION.
#
# Everything the server hands back as an absolute URL is built from it: the
# calendar feed address (which carries the student's feed token), the OAuth
# return redirect, and the OpenGraph image URL in link previews. Without it the
# origin is read from the X-Forwarded-Host / Host request header, which a client
# can forge on a host that does not overwrite it -- and a forged feed URL is a
# link that hands the student's whole semester to someone else's server.
APP_URL=

# --- Product analytics and A/B tests (PostHog) ---
#
# Optional. Without a key, analytics is off: every event still writes its
# `analytics.<name>` line to the log drain, the A/B tests still run and are
# still decided the same way, and nothing in the UI changes. Only the funnel
# charts are missing.
#
# The PROJECT key, from PostHog > Settings > Project. It is designed to be
# public -- it can write events and read nothing -- which is why the server and
# the browser share it and why NEXT_PUBLIC_ is correct here. Do NOT put a
# personal API key in this variable; those can read your whole project.
NEXT_PUBLIC_POSTHOG_KEY=
# Region host. US is the default; use https://eu.i.posthog.com for an EU
# project. This value is also what next.config.ts opens in the Content-Security
# -Policy, so pointing it somewhere else needs no second edit.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
#
# What gets sent is deliberately narrow, and the privacy policy says so:
# named events, a pseudonymous account id, and ordinary web context. No
# autocapture, no session replay, no syllabus content, no Google data, no email
# address. See src/lib/analytics-client.ts -- the settings there are the
# promise, not a note asking someone to remember it.

# The price arm of the Term Pass A/B test (src/lib/experiments.ts).
#
# Leave UNSET and the experiment is off: everyone gets STRIPE_TERM_PASS_PRICE_ID
# above, which is the fallback for every arm. Set it to a second Stripe price id
# and half of new students are quoted that instead -- stickily, so nobody is
# ever shown two different prices.
#
# The AMOUNT is not configured here on purpose. It is read back from Stripe for
# whichever price id applies, so the figure on the paywall cannot drift from the
# figure on the card. The Terms promise exactly that.
STRIPE_TERM_PASS_PRICE_ID_HIGHER=

# Deployment-wide ceilings on model spend, tunable without a deploy.
#
# The defaults (120/minute, 5000/day) are sized for roughly a thousand users.
# Raise them as you grow; the failure mode of leaving them too low is that
# legitimate students get turned away at the busiest week of the semester.
#
# Held in memory, so on serverless these are PER-INSTANCE brakes rather than a
# true global ceiling. The hard stop is the monthly spend limit on the OpenAI
# account itself -- set one, these are not a substitute. Per-visitor abuse is a
# different control: see `demo:ip` in src/lib/ratelimit.ts.
OPENAI_GLOBAL_BURST_CAP=120
OPENAI_GLOBAL_DAILY_CAP=5000

# --- Email alerts ---
#
# Optional, and the thing that turns logging into knowing. Without these, every
# failure is still logged in full; it just waits for somebody to go looking.
# With them, the failures worth acting on arrive in an inbox.
#
# What alerts: every `error`-level line, plus a short allow-list of `warn`
# events that mean a student was charged and something did not happen --
# `stripe.webhook_grant_missed` above all, which is "paid, no access". See
# src/lib/alerts.ts; the allow-list exists because a severity threshold alone
# would miss every one of them.
#
# Throttled hard on purpose: at most one email per event name per hour, and at
# most 20 an hour in total, so a broken deploy cannot flood the inbox. An alert
# address you learn to ignore is worse than no alerting.
#
# API key from https://resend.com (free tier covers this many times over). Any
# provider with an HTTP API works -- `send()` in src/lib/alerts.ts is ~20 lines
# of fetch and is the only thing that knows which one you use.
RESEND_API_KEY=
# Where alerts go. Comma-separated for more than one.
ALERT_EMAIL_TO=
# Must be on a domain verified with the provider, or every send is rejected.
ALERT_EMAIL_FROM=alerts@syllabuscenter.com

# Who may open /admin, the operator's metrics page (sign-ups, paying members,
# passes sold). Comma-separated Google account addresses, matched against the
# signed-in user's email, case-insensitively.
#
# Unset means nobody: /admin returns 404 for everyone, including you. That is
# deliberate -- a metrics page that exists by default on every fork is a page
# somebody forgot about. It 404s rather than 403s for a signed-in non-admin too,
# so the URL does not confirm its own existence to a curious student.
ADMIN_EMAILS=

# Signs the session cookie. REQUIRED IN PRODUCTION -- the app refuses to serve
# requests without it (>= 32 chars), because the dev fallback is a published
# constant and anyone knowing it can forge a session for any account.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Persistence: pick ONE of the two options below for production. ---
#
# Option A: a mounted volume. The JSON store writes to $DATA_DIR/db.json, so
# pointing this at a volume mount (Railway, Fly, a Docker bind mount) makes the
# data outlive the container. Simplest path for a small deployment.
# Requires ONE instance -- the file is guarded by an in-process lock, so two
# replicas sharing a volume would overwrite each other.
# DATA_DIR=/data
#
# Option B: Supabase (Postgres). Needed once you scale past one instance.
# Run supabase/schema.sql against the project first.
# The service-role key bypasses RLS: server-only, never NEXT_PUBLIC_.
#
# With NEITHER set, data goes to ./.data/db.json inside the deployment and is
# lost on the next redeploy. Fine locally; silent data loss in production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
